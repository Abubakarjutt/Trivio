generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum BusinessType {
  SOLE_TRADER
  PARTNERSHIP
  COMPANY
  OTHER
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  EDITOR
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntrySource {
  MANUAL
  INVOICE
  BILL
  BANK_IMPORT
  AI_EXTRACTION
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
  CREATED
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  VOID
  DELETE
}

enum OnboardingStep {
  BUSINESS_INFO
  CURRENCY_TAX
  COMPLETE
}

enum Plan {
  FREE
  PRO
}

enum LsSubscriptionStatus {
  active
  cancelled
  past_due
  expired
}

// ─── Organisation & Users ─────────────────────────────────────────────────────

model Organisation {
  id                   String           @id @default(cuid())
  name                 String
  businessType         BusinessType     @default(SOLE_TRADER)
  currency             String           @default("USD") // ISO 4217
  fiscalYearStartMonth Int              @default(1) // 1 = January
  subscriptionTier     SubscriptionTier @default(FREE)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  onboardingStep       OnboardingStep   @default(BUSINESS_INFO)
  onboardingComplete   Boolean          @default(false)
  emailImportToken     String           @unique @default(cuid())
  plan                   Plan                  @default(FREE)
  lsCustomerId           String?
  lsSubscriptionId       String?               @unique
  lsSubscriptionStatus   LsSubscriptionStatus?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  taxRegimeId String?
  taxRegime   TaxRegime? @relation(fields: [taxRegimeId], references: [id])

  users             User[]
  chartAccounts     ChartAccount[]
  journalEntries    JournalEntry[]
  contacts          Contact[]
  invoices          Invoice[]
  bills             Bill[]
  bankAccounts      BankAccount[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  usageRecords      UsageRecord[]
  chatConversations ChatConversation[]
  budgets           Budget[]
  goals             Goal[]
  recurringItems    RecurringItem[]
  watchlists             Watchlist[]
  statementImportBatches StatementImportBatch[]
  statementTransactions  StatementTransaction[]
  // CRM
  crmLeads          CrmLead[]
  crmCompanies      CrmCompany[]
  crmPipelines      CrmPipeline[]
  crmDeals          CrmDeal[]
  crmActivities     CrmActivity[]

  @@index([emailImportToken])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  hashedPassword String?
  emailVerified  DateTime?
  role           UserRole @default(OWNER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  accounts          Account[]          @relation("AuthAccounts")
  sessions          Session[]
  auditLogs         AuditLog[]
  chatConversations ChatConversation[]
  // CRM
  assignedLeads     CrmLead[]          @relation("CrmLeadAssignedTo")
  crmActivities     CrmActivity[]      @relation("CrmActivityCreatedBy")

  @@index([organisationId])
}

// NextAuth.js v5 required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation("AuthAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tax ─────────────────────────────────────────────────────────────────────

model TaxRegime {
  id      String @id @default(cuid())
  code    String @unique // e.g. "UK_VAT", "US_SALES_TAX"
  name    String
  country String

  rates         TaxRate[]
  organisations Organisation[]
  invoiceLines  InvoiceLine[]
  billLines     BillLine[]
}

model TaxRate {
  id          String    @id @default(cuid())
  taxRegimeId String
  taxRegime   TaxRegime @relation(fields: [taxRegimeId], references: [id])
  code        String // e.g. "STANDARD", "ZERO", "EXEMPT"
  name        String // e.g. "Standard Rate (20%)"
  rate        Decimal   @db.Decimal(5, 4) // e.g. 0.2000

  @@unique([taxRegimeId, code])
}

// ─── Chart of Accounts ───────────────────────────────────────────────────────

model ChartAccount {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String // e.g. "1000"
  name           String // e.g. "Cash at Bank"
  type           AccountType
  normalBalance  NormalBalance
  description    String?
  parentId       String?
  parent         ChartAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       ChartAccount[] @relation("AccountHierarchy")
  isArchived     Boolean        @default(false)
  isSystem       Boolean        @default(false) // system accounts cannot be deleted
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  journalLines      JournalLine[]
  bankAccounts      BankAccount[]

  @@unique([organisationId, code])
  @@index([organisationId])
}

// ─── Journal ──────────────────────────────────────────────────────────────────

model JournalEntry {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  date           DateTime           @db.Date
  reference      String?
  description    String
  source         JournalEntrySource @default(MANUAL)
  sourceId       String? // polymorphic FK to Invoice, Bill, etc.
  isVoid         Boolean            @default(false)
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines JournalLine[]

  @@index([organisationId, date])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartAccount @relation(fields: [accountId], references: [id])
  debit          Decimal?     @db.Decimal(19, 4)
  credit         Decimal?     @db.Decimal(19, 4)
  description    String?

  bankStatementLines BankStatementLine[]
}

// ─── Contacts ─────────────────────────────────────────────────────────────────

model Contact {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type           ContactType
  name           String
  email          String?
  phone          String?
  address        String?
  taxNumber      String?
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices Invoice[]
  bills    Bill[]

  // CRM back-relations
  crmLeads      CrmLead[]     @relation("CrmLeadContact")
  crmCompany    CrmCompany?   @relation("CrmCompanyContact")
  crmDeals      CrmDeal[]     @relation("CrmDealContact")
  crmActivities CrmActivity[] @relation("CrmActivityContact")

  @@index([organisationId])
}

// ─── Invoices (AR) ────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])
  number         String
  date           DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(19, 4) @default(0)
  taxAmount      Decimal       @db.Decimal(19, 4) @default(0)
  totalAmount    Decimal       @db.Decimal(19, 4) @default(0)
  amountPaid     Decimal       @db.Decimal(19, 4) @default(0)
  notes          String?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines       InvoiceLine[]
  attachments Attachment[]
  crmDeal     CrmDeal?      @relation("CrmDealInvoice")

  @@unique([organisationId, number])
  @@index([organisationId, status])
}

model InvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal    @db.Decimal(10, 4) @default(1)
  unitPrice   Decimal    @db.Decimal(19, 4)
  amount      Decimal    @db.Decimal(19, 4)
  taxRegimeId String?
  taxRegime   TaxRegime? @relation(fields: [taxRegimeId], references: [id])
  taxRateCode String?
  taxAmount   Decimal    @db.Decimal(19, 4) @default(0)
  sortOrder   Int        @default(0)
}

// ─── Bills (AP) ───────────────────────────────────────────────────────────────

model Bill {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])
  number         String?
  date           DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(19, 4) @default(0)
  taxAmount      Decimal       @db.Decimal(19, 4) @default(0)
  totalAmount    Decimal       @db.Decimal(19, 4) @default(0)
  amountPaid     Decimal       @db.Decimal(19, 4) @default(0)
  notes          String?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines       BillLine[]
  attachments Attachment[]

  @@index([organisationId, status])
}

model BillLine {
  id          String     @id @default(cuid())
  billId      String
  bill        Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal    @db.Decimal(10, 4) @default(1)
  unitPrice   Decimal    @db.Decimal(19, 4)
  amount      Decimal    @db.Decimal(19, 4)
  taxRegimeId String?
  taxRegime   TaxRegime? @relation(fields: [taxRegimeId], references: [id])
  taxRateCode String?
  taxAmount   Decimal    @db.Decimal(19, 4) @default(0)
  sortOrder   Int        @default(0)
}

// ─── Bank ─────────────────────────────────────────────────────────────────────

model BankAccount {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  accountId      String // FK → ChartAccount
  chartAccount   ChartAccount @relation(fields: [accountId], references: [id])
  currentBalance Decimal      @db.Decimal(19, 4) @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  statementLines BankStatementLine[]

  @@index([organisationId])
}

model BankStatementLine {
  id            String                  @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount             @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date          DateTime                @db.Date
  description   String
  amount        Decimal                 @db.Decimal(19, 4)
  status        BankStatementLineStatus @default(UNMATCHED)
  journalLineId String?
  journalLine   JournalLine?            @relation(fields: [journalLineId], references: [id])
  importedAt    DateTime                @default(now())

  @@index([bankAccountId, status])
}

// ─── Attachments & AI Extraction ─────────────────────────────────────────────

model Attachment {
  id               String           @id @default(cuid())
  organisationId   String
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  s3Key            String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  extractionStatus ExtractionStatus @default(PENDING)
  extractionResult Json?
  invoiceId        String?
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  billId           String?
  bill             Bill?            @relation(fields: [billId], references: [id])
  uploadedAt       DateTime         @default(now())

  chatMessages ChatMessage[]

  @@index([organisationId])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  action         AuditAction
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organisationId, entityType, entityId])
}

// ─── Chat ─────────────────────────────────────────────────────────────────

model ChatConversation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages ChatMessage[]

  @@index([organisationId])
  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String           // "user" | "assistant"
  content        String
  toolCalls      Json?
  toolResults    Json?
  attachmentId   String?
  attachment     Attachment?      @relation(fields: [attachmentId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

// ─── Personal Finance (EasyFinance module) ────────────────────────────────────

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringType {
  INCOME
  EXPENSE
}

model Budget {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  limitAmount    Decimal      @db.Decimal(19, 4)
  period         BudgetPeriod @default(MONTHLY)
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

model Goal {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  targetAmount   Decimal      @db.Decimal(19, 4)
  currentAmount  Decimal      @db.Decimal(19, 4) @default(0)
  targetDate     DateTime?    @db.Date
  status         GoalStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

model RecurringItem {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  amount         Decimal            @db.Decimal(19, 4)
  type           RecurringType
  frequency      RecurringFrequency @default(MONTHLY)
  category       String?
  nextDueDate    DateTime           @db.Date
  isActive       Boolean            @default(true)
  lastPaidAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organisationId])
}

model Watchlist {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  threshold      Decimal      @db.Decimal(19, 4)
  period         BudgetPeriod @default(MONTHLY)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

// ─── Statement Import ─────────────────────────────────────────────────────────

enum StatementFileType {
  PDF
  CSV
  IMAGE
  EMAIL
}

enum StatementImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum StatementTransactionType {
  DEBIT
  CREDIT
}

model StatementImportBatch {
  id               String                @id @default(cuid())
  organisationId   String
  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  filename         String
  fileType         StatementFileType
  status               StatementImportStatus @default(PENDING)
  transactionCount     Int                   @default(0)
  errorMessage         String?
  pendingDuplicatesJson Json?
  createdAt            DateTime              @default(now())

  transactions StatementTransaction[]

  @@index([organisationId])
}

model StatementTransaction {
  id             String                   @id @default(cuid())
  organisationId String
  organisation   Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importBatchId  String
  importBatch    StatementImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  date           DateTime                 @db.Date
  description    String
  merchantName   String
  amount         Decimal                  @db.Decimal(19, 4)
  type           StatementTransactionType

  category       String
  mccCode        String
  mccLabel       String

  isExcluded     Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organisationId])
  @@index([importBatchId])
  @@index([organisationId, date])
  @@index([organisationId, category])
}

// ─── CRM Module ───────────────────────────────────────────────────────────────

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum CrmLeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_OUTREACH
  EVENT
  ADVERTISING
  OTHER
}

enum CrmCompanySize {
  SOLO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

model CrmLead {
  id                 String        @id @default(cuid())
  organisationId     String
  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  email              String?
  phone              String?
  companyName        String?
  jobTitle           String?
  estimatedValue     Decimal?      @db.Decimal(19, 4)
  source             CrmLeadSource @default(OTHER)
  notes              String?
  status             CrmLeadStatus @default(NEW)
  assignedToId       String?
  assignedTo         User?         @relation("CrmLeadAssignedTo", fields: [assignedToId], references: [id])
  tags               String[]
  convertedAt        DateTime?
  convertedContactId String?
  convertedContact   Contact?      @relation("CrmLeadContact", fields: [convertedContactId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organisationId, status])
  @@index([organisationId, source])
}

model CrmCompany {
  id              String         @id @default(cuid())
  organisationId  String
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name            String
  industry        String?
  website         String?
  phone           String?
  address         String?
  size            CrmCompanySize @default(SMALL)
  tags            String[]
  notes           String?
  linkedContactId String?        @unique
  linkedContact   Contact?       @relation("CrmCompanyContact", fields: [linkedContactId], references: [id])
  deals           CrmDeal[]
  activities      CrmActivity[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organisationId])
}

model CrmPipeline {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean            @default(false)
  stages         CrmPipelineStage[]
  deals          CrmDeal[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organisationId])
}

model CrmPipelineStage {
  id          String      @id @default(cuid())
  pipelineId  String
  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  probability Int         @default(50)
  deals       CrmDeal[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([pipelineId, order])
}

model CrmDeal {
  id                String           @id @default(cuid())
  organisationId    String
  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name              String
  value             Decimal          @db.Decimal(19, 4) @default(0)
  contactId         String
  contact           Contact          @relation("CrmDealContact", fields: [contactId], references: [id])
  crmCompanyId      String?
  crmCompany        CrmCompany?      @relation(fields: [crmCompanyId], references: [id])
  pipelineId        String
  pipeline          CrmPipeline      @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             CrmPipelineStage @relation(fields: [stageId], references: [id])
  expectedCloseDate DateTime?        @db.Date
  probability       Int              @default(50)
  source            String?
  wonLostReason     String?
  closedAt          DateTime?
  invoiceId         String?          @unique
  invoice           Invoice?         @relation("CrmDealInvoice", fields: [invoiceId], references: [id])
  activities        CrmActivity[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organisationId, stageId])
  @@index([organisationId, pipelineId])
}

model CrmActivity {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type           CrmActivityType
  subject        String
  notes          String?
  dueDate        DateTime?
  completedAt    DateTime?
  contactId      String?
  contact        Contact?        @relation("CrmActivityContact", fields: [contactId], references: [id])
  dealId         String?
  deal           CrmDeal?        @relation(fields: [dealId], references: [id])
  crmCompanyId   String?
  crmCompany     CrmCompany?     @relation(fields: [crmCompanyId], references: [id])
  createdById    String
  createdBy      User            @relation("CrmActivityCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId, contactId])
  @@index([organisationId, dealId])
  @@index([organisationId, dueDate])
}

// ─── Usage Tracking ───────────────────────────────────────────────────────────

model UsageRecord {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  month          String // "2026-05" format
  transactionCount Int        @default(0)
  aiExtractionCount Int       @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, month])
}

// ─── Webhook Idempotency ──────────────────────────────────────────────────────

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  status      String    @default("PROCESSING")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, eventId])
  @@index([provider, status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique @default(cuid())
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
