{
  "name": "autoaccounts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --include 'tests/integration/**/*.test.ts'",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx server/workers/extraction.worker.ts",
    "build:electron": "node desktop/build-electron.mjs",
    "gen:icon": "node desktop/build/icon-generator.mjs",
    "build:server": "node desktop/assemble-server.mjs",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json --noEmit",
    "dev:desktop": "node desktop/build-electron.mjs && node desktop/dev.mjs",
    "dev:desktop:local": "node desktop/build-electron.mjs && npm run build:server && DESKTOP_MODE=local electron desktop/dist/main.cjs",
    "build:desktop": "npm run build && npm run build:electron && npm run gen:icon && npm run build:server && electron-builder --config desktop/electron-builder.yml --mac",
    "package:desktop": "node desktop/build-electron.mjs && npm run build:server && electron-builder --config desktop/electron-builder.yml --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.75.5",
    "@trpc/client": "^11.1.2",
    "@trpc/next": "^11.1.2",
    "@trpc/react-query": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.46.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-rehype": "^11.1.2",
    "resend": "^6.18.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "postal-mime": "^2.7.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.1.4"
  }
}
