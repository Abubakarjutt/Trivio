# Database
# Web / CI / external: this is the Postgres the app connects to. On the macOS
# DESKTOP app this is IGNORED by default — the app runs its own built-in
# (embedded) Postgres and needs no docker. See "Embedded database (desktop)" below.
DATABASE_URL="postgresql://autoaccounts:autoaccounts@localhost:5432/autoaccounts"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Redis
REDIS_URL="redis://localhost:6379"

# S3 / MinIO (use MinIO for local dev)
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET="autoaccounts"
AWS_ACCESS_KEY_ID="autoaccounts"
AWS_SECRET_ACCESS_KEY="autoaccounts"
AWS_REGION="us-east-1"

# Anthropic Claude API
ANTHROPIC_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Lemon Squeezy (billing)
LEMONSQUEEZY_CHECKOUT_UUID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="AutoAccounts <noreply@autoaccounts.app>"

# Google Gemini API (for PDF/image statement parsing and categorization)
GEMINI_API_KEY="your-google-ai-studio-api-key"
GEMINI_MODEL="gemma-4-26b-a4b-it"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Skip the email verification round-trip on registration and activate new
# accounts immediately. Local/dev convenience only — never set this for a
# hosted/production deployment.
SKIP_EMAIL_VERIFICATION="false"

# ── macOS desktop (see desktop/README.md) ───────────────────────────────────
# The desktop shell loads this same .env via ~/.trivio/.env (copy this file
# there), TRIVIO_ENV_FILE, or the packaged server dir. AUTH_TRUST_HOST is set
# automatically by the shell for the embedded server. DESKTOP_MODE selects
# dev (default, uses `next dev`) | local (boots .next/standalone) | remote
# (loads an already-hosted URL; no local server needed).
DESKTOP_MODE="auto"
# E.g.: DESKTOP_MODE="remote" and ELECTRON_REMOTE_URL="https://app.trivio-ai.com"
# ── Embedded database (desktop default — no docker) ─────────────────────────
# The macOS desktop app ships and runs its OWN PostgreSQL inside your user data
# dir on first boot (initdb + migrate), so you never need `docker compose up`
# or a DATABASE_URL. This is the default. Fetch the engine once with
#   npm run fetch:pg
# (the build does this automatically). Data lives at
#   ~/Library/Application Support/Trivio/database
# Use an EXTERNAL database instead only by opting in — set one of:
#   TRIVIO_DATABASE_MODE="external"        # then DATABASE_URL above is used
#   TRIVIO_DATABASE_URL="postgresql://..." # an explicit external pointer
# (TRIVIO_DATABASE_MODE wins; "embedded" forces the built-in engine.)
# TRIVIO_DATABASE_MODE="embedded"
