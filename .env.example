# Database
DATABASE_URL="postgresql://autoaccounts:autoaccounts@localhost:5432/autoaccounts"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Redis
REDIS_URL="redis://localhost:6379"

# S3 / MinIO (use MinIO for local dev)
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_BUCKET="autoaccounts"
AWS_ACCESS_KEY_ID="autoaccounts"
AWS_SECRET_ACCESS_KEY="autoaccounts"
AWS_REGION="us-east-1"

# Anthropic Claude API
ANTHROPIC_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Lemon Squeezy (billing)
LEMONSQUEEZY_CHECKOUT_UUID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="AutoAccounts <noreply@autoaccounts.app>"

# Google Gemini API (for PDF/image statement parsing and categorization)
GEMINI_API_KEY="your-google-ai-studio-api-key"
GEMINI_MODEL="gemma-4-26b-a4b-it"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── macOS desktop (see desktop/README.md) ───────────────────────────────────
# The desktop shell loads this same .env via ~/.trivio/.env (copy this file
# there), TRIVIO_ENV_FILE, or the packaged server dir. AUTH_TRUST_HOST is set
# automatically by the shell for the embedded server. DESKTOP_MODE selects
# dev (default, uses `next dev`) | local (boots .next/standalone) | remote
# (loads an already-hosted URL; no local server needed).
DESKTOP_MODE="auto"
# E.g.: DESKTOP_MODE="remote" and ELECTRON_REMOTE_URL="https://app.trivio-ai.com"
