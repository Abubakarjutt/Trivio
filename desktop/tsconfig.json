{
   "compilerOptions": {
      "target": "ES2022",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "lib": ["ES2022", "DOM"],
      "types": ["node"],
      "strict": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "noEmit": true,
      "resolveJsonModule": true,
      "forceConsistentCasingInFileNames": true
      },
   "include": ["main.ts", "preload.ts", "embedded/embedded-db.ts"]
}
